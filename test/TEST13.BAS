  10 DIM V(20)
  15 LET X = -1.57
  20 FOR I = 1 TO 20
  30 LET V(I) = 1 + SIN(X)
  35 LET X = X + 0.314
  50 NEXT I
  60 REM PRINT THE HISTOGRAM
 210 FOR I = 1 TO 20
 220 PRINT I; " ";
 230 IF I > 9 THEN 250
 240 PRINT " ";              ' PRINT ANOTHER SPACE IF I HAS JUST ONE DIGIT
 250 FOR J = 1 TO V(I)*10
 260 PRINT "*";
 270 NEXT J
 280 PRINT
 290 NEXT I
 999 END
