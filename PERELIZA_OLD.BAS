   5 REM
  10 REM  VARIABLE DEFINITIONS
  11 REM
  20 DIM W$(2048)   ' WORDS TABLE
  22 LET W0 = 1     ' NEXT FREE ITEM IN WORDS TABLE
  25 DIM K(128, 3)  ' KEYWORDS TABLE
  26 LET K(0,0) = 128
  27 LET K0 = 1     ' NEXT FREE ITEM IN KEYWORDS TABLE
  30 DIM S(4096, 2) ' S-EXPRESSION TABLE
  31 LET S(0,0) = 4096
  33 LET S0 = 1     ' NEXT FREE ITEM IN S-EXPRESSIONS TABLE
  35 DIM T(128)     ' KEYWORD STACK
  36 LET T(0) = 128
  37 LET T0 = 1     ' TOP OF KEY STACK
  38 LET T9 = 128   ' BOTTOM OF KEY STACK
  50 REM P$, P() = PARSED SENTENCE: ITS ELEMENTS ARE INDEXES IN W$()
  55 LET P0 = 1
  57 DIM P(128)
  60 REM  GENERIC VECTORS USED TO CHANGE A STRING
  65 DIM X(256), Y(256)
  66 REM  VARIABLES X1, X2, ... X1$, ... ARE PARAMETERS OF SUBROUTINES
  67 REM  VARIABLES Y1, Y2, ... Y1$, ... ARE RETURN VALUES OF SUBROUTINES
  70 DIM X1(256), X2(256), Y1(256)
  90 LET E$ = ""     ' ERROR TEXT, IF EMPTY THEN NO ERROR
 100 REM
 101 REM    MAIN PROGRAM
 102 REM
 110 GOSUB 1000      ' PARSE SCRIPT
 120 GOSUB 2000      ' CONVERSATION
 130 STOP
 150 REM
 151 REM    STOP DUE TO SCRIPT ERROR (IN E$)
 152 REM
 160 PRINT "SCRIPT ERROR: "; E$; " AT ROW "; R0
 170 STOP
 400 REM
 401 REM    SUBROUTINE: INSERT WORD
 402 REM    INSERT X1() INTO TABLE W$ AND RETURN ITS INDEX Y1
 403 REM    RETURN ALSO IN Y1$ THE INSERTED WORD.
 404 REM
 410 CHANGE X1 TO Y1$
 415 FOR Y1 = 1 TO W0 - 1
 420 IF Y1$ = W$(Y1) THEN 459
 425 NEXT Y1
 430 IF W0 < 2048 THEN 445
 435 LET E$ = "WORDS TABLE FULL"
 440 GOTO 150
 445 LET W$(W0) = Y1$
 450 LET W0 = W0 + 1
 459 RETURN
 500 REM
 501 REM    SUBROUTINE PARSE DATA TOKEN
 502 REM    IN P0 = NEXT CHARACTER TO PARSE IN THE STRING P$ = P()
 503 REM    IN R0 = ROW OF THE SCRIPT UNDER PARSING
 504 REM    OUT Y1 = INDEX OF THE SYMBOL IN W$, Y1$ = W$(Y1)
 505 IF P0 > P(0) THEN 510
 506 IF P0 > 0 THEN 550
 510  READ P$
 515  CHANGE P$ TO P
 520  LET P0 = 1
 525  LET R0 = R0 + 1
 530  IF P(0) > 0 THEN 505
 535     LET P0 = 0
 540  GOTO 505
 545 REM SKIP SPACES UNTIL A WORD OR THE END OF THE STRING IS FOUND
 550 IF P(P0) <> 32 THEN 580
 555  LET P0 = P0 + 1
 560  IF P0 <= P(0) THEN 550
 565  LET P0 = 0
 570  GOTO 505
 575 REM CHECK AGAINST A LETTER
 580 IF P(P0) < 65 THEN 630
 581 IF P(P0) > 90 THEN 630
 585 REM FOUND A LETTER: PARSE THE WORD UNTIL A NON LETTER IS FOUND
 590 LET I = 0
 595  LET I = I + 1
 600  LET X1(I) = P(P0)    ' COPY THE WORD ALSO IN X1()
 605  LET P0 = P0 + 1
 610  IF P0 > P(0) THEN 620
 611  IF P(P0) < 65 THEN 620
 612  IF P(P0) > 90 THEN 620
 615 GOTO 595
 620 LET X1(0) = I   ' WRITE THE LENGTH OF THE WORD
 625 GOTO 400           ' INSERT WORD X1 INTO W$() AND RETURN
 629 REM HERE P(P0) IS NOT A LETTER: CONSIDER IT AS A SINGLE WORD
 630 LET X1(0) = 1
 635 LET X1(1) = P(P0)
 640 LET P0 = P0 + 1
 645 GOTO 400           ' INSERT WORD X1 INTO W$() AND RETURN
1000 REM
1001 REM    SUBROUTINE PARSE SCRIPT
1010 LET R0 = 1
1015 LET P0 = 0
1020 GOSUB 500          ' PARSE TOKEN FROM SCRIPT INTO Y1$, Y1()
1025 IF Y1$ = "START" THEN 1080
1030 IF Y1$ = "(" THEN 1050
1035 LET E$ = "'(' EXPECTED"
1040 GOTO 150
1045 REM PRINT EACH WORD IN THE LIST
1050  GOSUB 500      ' PARSE TOKEN FROM SCRIPT INTO Y1$, Y1()
1055  IF Y1$ = ")" THEN 1070
1060  PRINT Y1$; " ";
1065 GOTO 1050
1070 PRINT
1075 GOTO 1020
1080 STOP
2000 STOP

9999 END