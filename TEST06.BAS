  10 REM CALCOLO DEL PI GRECO CON IL METODO DI MONTE CARLO
  20 PRINT "NUMBER OF STEPS"
  30 INPUT N
  50 LET C = 0
  60 FOR I = 1 TO N
  70 LET X = RND(0)
  80 LET Y = RND(0)
  90 IF X^2 + Y^2 > 1 THEN 110
 100 LET C = C + 1
 110 NEXT I
 120 REM HERE C = #TIMES A POINT WAS IN THE CIRCLE
 130 PRINT "PI ="; 4*C/N
 999 END
