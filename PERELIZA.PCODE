   5 REM
  10 REM  VARIABLE DEFINITIONS
  11 REM
  20 DIM W$(2048)   ' WORDS TABLE
  22 LET W0 = 1     ' NEXT FREE ITEM IN WORDS TABLE
  25 DIM K(128, 3)  ' KEYWORDS TABLE
  27 LET K0 = 1     ' NEXT FREE ITEM IN KEYWORDS TABLE
  30 DIM S(4096, 2) ' S-EXPRESSION TABLE
  33 LET S0 = 1     ' NEXT FREE ITEM IN S-EXPRESSIONS TABLE
  36 DIM T(128)     ' KEYWORD STACK
  37 LET T0 = 1     ' TOP OF KEY STACK
  38 LET T9 = 128   ' BOTTOM OF KEY STACK
  50 REM P$, P() = PARSED SENTENCE: ITS ELEMENTS ARE INDEXES IN W$()
  55 LET P0 = 1
  57 DIM P(128)
  60 REM  GENERIC VECTORS USED TO CHANGE A STRING
  65 DIM X(256), Y(256)
  66 REM  VARIABLES X1, X2, ... X1$, ... ARE PARAMETERS OF SUBROUTINES
  67 REM  VARIABLES Y1, Y2, ... Y1$, ... ARE RETURN VALUES OF SUBROUTINES
  70 DIM X1(256), X2(256), Y1(256)

  90 LET E$ = ""     ' ERROR TEXT, IF EMPTY THEN NO ERROR
 
 100 REM
 101 REM    MAIN PROGRAM
 102 REM
 110 GOSUB 1000      ' PARSE SCRIPT
 120 GOSUB 2000      ' CONVERSATION
 130 STOP

 150 REM
 151 REM    STOP DUE TO SCRIPT ERROR (IN E$)
 152 REM
 160 PRINT "SCRIPT ERROR: "; E$; " AT ROW "; ROW
 170 STOP

 200 REM  SUBROUTINE: CONCATENATES X1$ AND X2$ INTO Y1$
 201 REM  (USE X1(), X2() AND Y1())
 210 CHANGE X1$ TO X1
 220 CHANGE X2$ TO X2
 230 LET Y1(0) = X1(0) + X2(0)
 240 FOR I = 1 TO X1(0)
 245 LET Y1(I) = X1(I)
 250 NEXT I
 260 FOR I = 1 TO X2(0)
 265 LET Y1(X1(0) + I) = X2(I)
 270 NEXT I
 260 CHANGE Y1 TO Y1$
 270 RETURN


1000 REM  SCRIPT PARSING 1: PRINT UNTIL START IS PARSED
1001 REM

PSEUDOCODE

FUNCTION INSERT_WORD:
   ' INSERT WORD X1() INTO TABLE W$ AND RETURN ITS INDEX INTO Y1
   ' RETURN ALSO W$(Y1) IN Y1$
   CHANGE X1 TO Y1$
   FOR Y1 = 1 TO W0:
      IF Y1$ == W$(Y1):
         RETURN
   ' APPEND THE WORD
   IF W0 == 2048:
      LET E$ = "WORDS TABLE FULL"
      GOTO 150
   LET Y1 = W0
   LET W$(Y1) = Y1$
   LET W0 = W0 + 1

FUNCTION PARSE_DATA_TOKEN:
   ' P0 = NEXT CHARACTER TO PARSE IN THE STRING P$ = P()
   ' RETURN IN Y1 THE INDEX OF THE SYMBOL IN W$
   WHILE P0 == 0:
      READ P$
      CHANGE P$ TO P
      LET P0 = 1
      LET R0 = R0 + 1
      IF P(0) == 0: P0 = 0
   ' SKIP SPACES
   WHILE P(P0) == 32:
      LET P0 = P0 + 1
      IF P0 > P(0):
         LET P0 = 0
         GOTO START
   IF P(P0) < 65 OR P(P0) > 90:  ' NOT A LETTER
      LET X1(0) = 1
      LET X1(1) = P(P0)
      LET P0 = P0 + 1
   ELSE:
      LET I = 0
      DO:
         LET I = I + 1
         LET X1(I) = P(P0)  ' COPIES THE WORD INSIDE X
         LET P0 = P0 + 1
      WHILE P0 <= P(0) AND P(P0) >= 65 AND P(P0) <= 90:
      LET X1(0) = I   ' INSERT LENGTH OF THE WORD
   ' NOW INSERT THE WORD X1 INSIDE TABLE W$ AND RETURN ITS INDEX INTO Y1
   GOSUB INSERT_WORD()

FUNCTION PARSE_SCRIPT:
   LET R0 = 1
   LET P0 = 0
   DO:
      CALL PARSE_DATA_TOKEN
      IF Y1$ == "START": BREAK
      IF Y1$ != "(":
         LET E$ = "'(' EXPECTED"
         GOTO 150
      ' PRINT EACH WORD OF THE LIST
      CALL PARSE_DATA_TOKEN
      WHILE Y1$ != ")":
         PRINT Y1$, " ",
         CALL PARSE_DATA_TOKEN
      PRINT
   ' NOW START HAS BEEN PARSED: READ S-EXPRESSIONS DESCRIBING KEYLIST
   ' (K [= ALIAS] [N] (PATTERN RULE1 ... RULEN) ...)
   DO:
      CALL PARSE_DATA_TOKEN
      IF Y1$ != "(":
         LET E$ = "'(' EXPECTED"
         GOTO 150
      ' READ THE KEYWORD OR A ")"
      CALL PARSE_DATA_TOKEN
      IF Y1$ == ")": RETURN
      IF K0 > 128:
         LET E$ = "TOO MANY KEYWORDS"
         GOTO 150
      LET K(K0,0) = Y1

   



1005 LET ROW = 1        ' ROW OF SCRIPT UNDER PROCESSING
1009 LET COL = 0        ' IF 0, A NEW ROW IS READ
1010 GOSUB PARSE_TOKEN_INTO_Y1$_Y1
1020 IF Y1$ = "START" THEN 1100
1030 IF Y1$ = "(" THEN 1060
1040 LET E$ = "'(' EXPECTED"
1050 RETURN
1055 REM  PRINT THE S-EXPRESSION WORD BY WORDS
1060 LET R$ = ""
1065 GOSUB PARSE_TOKEN_INTO_Y1$_Y1
1070 IF Y1$ = ")" THEN 1010
1075 LET X1$ = R$
1080 LET X2$ = Y1$
1085 GOSUB 200
1090 LET MSG$ = Y1$
1095 GOTO 2065
1097 REM
1098 REM  SCRIPT PARSING 2: PARSE KEYWORDS-PATTERNS-RULES
1099 REM
1100 LET X1$ = Y1$
1110 GOSUB INSERT_OR_RETRIEVE_WORD LEAVE THE INDEX IN WORDS() IN Y1
1115 REM INSERT THE KEYWORD IN THE K() TABLE
1120 IF K1 < K0 THEN 1140
1125 LET E$ = "KEYWORD TABLE FULL"
1130 RETURN
1140 LET K(K1, 0) = Y1
1150 GOSUB PARSE_TOKEN_INTO_Y1$_Y1
1150 IF Y1$ <> "=" THEN
1160 GOSUB PARSE_TOKEN_INTO_Y1$_Y1
1170


1200 REM  SUBROUTINE: PARSE NEXT TOKEN FROM SCRIPT
1201 REM    X1 = INDEX OF LAST STRING READ IN THE SCRIPT
1202 REM    X, X$ = STRING CURRENTLY READ IN THE SCRIPT
1203 REM    X1 = INDEX OF THE NEXT CHARACTER TO READ IN X$
1210 IF X0 > 0 THEN 1260
1220 READ X$
1230 CHANGE X$ TO X
1240 LET X0 = 1
1250 LET X1 = 1
1260 



2010 READ X$
2020 GOSUB PARSE X$ INTO P()
2030 IF P(1) <> -1 THEN
2031 IF P(2) <> -2 THEN
2035 REM HERE X$ = "()": END OF SCRIPT
2040 RETURN
2050 

2999 RETURN

3000 REM  SUBROUTINE: CONVERSATION
3005 REM

3999 RETURN


9999 END