/*
   PSEUDOCODE DESCRIPTION OF PERELIZA: AS USUAL IN THE OLD DAYS, THIS IS A HIGH
   LEVEL VERSION OF THE PROGRAM, EXPRESSED IN A PSEUDO-LANGUAGE BUILT ON TOP OF
   BASIC DATA STRUCTURES.

   RECALL THAT, IN BASIC66, VECTORS AND ARRAYS ARE 0-BASED BUT THAT USUALLY THE
   0-TH ELEMENT IS NOT USED. THIS IS FOR COMPATIBILITY WITH THE ACTUAL
   DARTMOUTH BASIC WHICH LET THE "MAT ..." INSTRUCTIONS IGNORING THE 0-INDEXED
   ELEMENTS.

   THE PSEUDO-CODE SYNTAX IS SELF-EXPLAINING, WITH A FLAVOR OF LATE 60S.
*/

PROGRAM PERELIZA

DEF VARS
   DIM K(128, 3)  // KEYWORD TABLE:
                  //    K(0,0) = NUMBERS OF ROWS OF K()
                  //    K(I,0) = INDEX OF THE KEYWORD IN W$()
                  //    K(I,1) = INDEX OF WORD SUBSTITUTING IT (0 IF NONE)
                  //    K(I,2) = RANK OF THE KEYWORD
                  //    K(I,3) = INDEX IN S() OF THE CORRESPONDING S-EXPRESSION
   LET K(0,0) = 128
   DIM S(4096,1)  // SYMBOLS TABLE:
                  //    S(0,0) = NUMBERS OF ROWS OF S()
                  //    S(I,0) = HEAD OF SYMBOL
                  //    S(I,1) = TAIL OF SYMBOL
                  // BOTH HEAD AND TAIL ARE INTEGERS, WHERE:
                  //    POSITIVE MEANS THE INDEX OF AN ELEMENT IN S()
                  //    NEGATIVE MEANS THE (NEGATION OF THE) INDEX OF AN ELEMENT IN W$()
                  //    ZERO MEANS NIL
   LET S(0,0) = 4096
   DIM T(128)     // KEYSTACK
   LET T(0) = 128
   DIM W$(2048)   // LIST OF ALL WORDS: A WORD IS IDENTIFIED BY IT INDEX IN W$
   LET E$ = ""    // ERROR MESSAGE (EMPTY MEANS "NO ERROR")
   LET K0 = 1     // FIRST FREE ITEM IN THE K() LIST
   LET R0 = 1     // NEXT STRING TO READ FROM DATA (USED TO SIGNAL ERRORS)
   LET S0 = 1     // FIRST FREE ITEM IN THE S() LIST
   LET T0 = 1     // TOP OF KEYSTACK
   LET T9 = T(0)  // BOTTOM OF KEYSTACK
   LET W0 = 1     // FIRST FREE ITEM IN THE W$() LIST

  50 REM P$, P() = PARSED SENTENCE: ITS ELEMENTS ARE INDEXES IN W$()
  55 LET P0 = 1
  57 DIM P(128)
  60 REM  GENERIC VECTORS USED TO CHANGE A STRING
  65 DIM X(256), Y(256)
  66 REM  VARIABLES X1, X2, ... X1$, ... ARE PARAMETERS OF SUBROUTINES
  67 REM  VARIABLES Y1, Y2, ... Y1$, ... ARE RETURN VALUES OF SUBROUTINES
  70 DIM X1(256), X2(256), Y1(256)
END VARS

// M A I N   P R O G R A M
DEF MAIN
   CALL PARSE_SCRIPT
   CALL CONVERSATION
END MAIN

// CALLED WHEN A PARSING ERROR OCCURS
DEF ERROR
   PRINT "SCRIPT ERROR: "; E$; " AT DATA STRING "; R0
   STOP
END ERROR

// INSERT WORD X1() INTO TABLE W$() AND RETURN ITS INDEX INTO Y1.
// RETURN ALSO W$(Y1) IN Y1$.
DEF INSERT_WORD
   CHANGE X1 TO Y1$
   FOR Y1 = 1 TO W0
      IF Y1$ = W$(Y1) THEN RETURN
   END FOR
   // APPEND THE WORD
   IF W0 = 2048
      LET E$ = "WORDS TABLE FULL"
      CALL ERROR
   END IF
   LET Y1 = W0
   LET W$(Y1) = Y1$
   LET W0 = W0 + 1
END INSERT_WORD

// PARSE A WORD FROM THE LAST READ STRING FROM DATA: IF NO WORD CAN BE
// PARSED, READ THE NEXT DATA STRING.
// EXPECT IN P0 THE NEXT CHARACTER TO PARSE IN THE STRING P$ = P()
// RETURN IN Y1 THE INDEX OF THE SYMBOL IN W$
DEF FUNCTION PARSE_DATA_TOKEN
   IF P0 > P(0) THEN P0 = 0   // RESET THE INDEX ON OVERFLOW
   WHILE P0 = 0
      READ P$
      CHANGE P$ TO P
      LET P0 = 1
      LET R0 = R0 + 1
      IF P(0) = 0 THEN P0 = 0
   END WHILE
   // SKIP SPACES
   WHILE P(P0) = 32
      LET P0 = P0 + 1
      IF P0 > P(0)
         LET P0 = 0
         RESTART     // SAME AS GO TO THE FIRST LINE OF THE SUBROUTINE
      END IF
   END WHILE
   IF P(P0) < 65 OR P(P0) > 90
      // P(P0) IS NOT A LETTER: CONSIDER IT TO BE A SINGLE WORD
      LET X1(0) = 1
      LET X1(1) = P(P0)
      LET P0 = P0 + 1
   ELSE
      LET I = 0
      REPEAT
         LET I = I + 1
         LET X1(I) = P(P0)  // COPIES THE WORD INSIDE X
         LET P0 = P0 + 1
      UNTIL P0 <= P(0) AND P(P0) >= 65 AND P(P0) <= 90:
      LET X1(0) = I        // INSERT LENGTH OF THE WORD
   END IF
   // NOW INSERT THE WORD X1 INSIDE TABLE W$ AND RETURN ITS INDEX INTO Y1
   CALL INSERT_WORD
END PARSE_DATA_TOKEN

DEF PARSE_SCRIPT
   LET R0 = 1
   LET P0 = 0
   BLOCK
      CALL PARSE_DATA_TOKEN
      IF Y1$ = "START" THEN RESTART    // NOT THE ALL SUBROUTINE, BUT THE BLOCK
      IF Y1$ <> "("
         LET E$ = "'(' EXPECTED"
         CALL ERROR
      END IF
      // PRINT EACH WORD OF THE LIST
      CALL PARSE_DATA_TOKEN
      WHILE Y1$ <> ")"
         PRINT Y1$, " ",
         CALL PARSE_DATA_TOKEN
      END WHILE
      PRINT
   END BLOCK
   // NOW READ S-EXPRESSIONS DESCRIBING KEYLIST AS:
   //    (K [= ALIAS] [N] (PATTERN RULE1 ... RULEN) ...)
   //
   DO:
      CALL PARSE_DATA_TOKEN
      IF Y1$ <> "(":
         LET E$ = "'(' EXPECTED"
         CALL ERROR
      END IF
      // READ THE KEYWORD OR A ")"
      CALL PARSE_DATA_TOKEN
      IF Y1$ == ")": RETURN
      IF K0 > 128:
         LET E$ = "TOO MANY KEYWORDS"
         GOTO 150
      LET K(K0,0) = Y1

   



1005 LET ROW = 1        ' ROW OF SCRIPT UNDER PROCESSING
1009 LET COL = 0        ' IF 0, A NEW ROW IS READ
1010 GOSUB PARSE_TOKEN_INTO_Y1$_Y1
1020 IF Y1$ = "START" THEN 1100
1030 IF Y1$ = "(" THEN 1060
1040 LET E$ = "'(' EXPECTED"
1050 RETURN
1055 REM  PRINT THE S-EXPRESSION WORD BY WORDS
1060 LET R$ = ""
1065 GOSUB PARSE_TOKEN_INTO_Y1$_Y1
1070 IF Y1$ = ")" THEN 1010
1075 LET X1$ = R$
1080 LET X2$ = Y1$
1085 GOSUB 200
1090 LET MSG$ = Y1$
1095 GOTO 2065
1097 REM
1098 REM  SCRIPT PARSING 2: PARSE KEYWORDS-PATTERNS-RULES
1099 REM
1100 LET X1$ = Y1$
1110 GOSUB INSERT_OR_RETRIEVE_WORD LEAVE THE INDEX IN WORDS() IN Y1
1115 REM INSERT THE KEYWORD IN THE K() TABLE
1120 IF K1 < K0 THEN 1140
1125 LET E$ = "KEYWORD TABLE FULL"
1130 RETURN
1140 LET K(K1, 0) = Y1
1150 GOSUB PARSE_TOKEN_INTO_Y1$_Y1
1150 IF Y1$ <> "=" THEN
1160 GOSUB PARSE_TOKEN_INTO_Y1$_Y1
1170


1200 REM  SUBROUTINE: PARSE NEXT TOKEN FROM SCRIPT
1201 REM    X1 = INDEX OF LAST STRING READ IN THE SCRIPT
1202 REM    X, X$ = STRING CURRENTLY READ IN THE SCRIPT
1203 REM    X1 = INDEX OF THE NEXT CHARACTER TO READ IN X$
1210 IF X0 > 0 THEN 1260
1220 READ X$
1230 CHANGE X$ TO X
1240 LET X0 = 1
1250 LET X1 = 1
1260 



2010 READ X$
2020 GOSUB PARSE X$ INTO P()
2030 IF P(1) <> -1 THEN
2031 IF P(2) <> -2 THEN
2035 REM HERE X$ = "()": END OF SCRIPT
2040 RETURN
2050 

2999 RETURN

3000 REM  SUBROUTINE: CONVERSATION
3005 REM

3999 RETURN


9999 END