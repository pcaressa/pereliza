5006   LET L(Y1 + 1) = 1
5007REM DEBUG     PRINT "INDEX RESET TO 1"
5009 GOTO 5015  ' ELSE
5010   LET L(Y1 + 1) = J + 1 ' NEXT TIME A DIFFERENT ANSWER
5012REM DEBUG     PRINT "INDEX INCREASED TO" J + 1
5015 LET I = Y1 + 2 + J     ' INDEX OF J-TH ITEM OF LIST (PATTERN EXCLUDED)
5020 LET Y$ = S$(L(I))          ' ANSWER TO REPLY AS A STRING
5025 CHANGE Y$ TO Y             ' CONVERT ALSO TO TABLE
5030 REM REM REM REM GOSUB 4900     ' APPLIES ALIASES TO W()
5033 REM NOW PARSE THE TRANSFORMATION Y() AND COPY IT TO Z(), REPLACING
5034 REM DIGITS WITH CORRESPONDING ELEMENTS OF M().
5035 LET Z0 = 1       ' NEXT CHARACTER OF Z() TO WRITE
5040 FOR I = 1 TO Y(0)
5045   LET C = Y(I) - 48
5050   IF C < 0 THEN 5200   ' NOT A DIGIT
5051   IF C > 9 THEN 5200   ' NOT A DIGIT
5070     REM DIGIT: COPIES THE WORDS OF W() FROM M(C,0) TO M(C,1)
5075REM DEBUG                PRINT "DIGIT " C
5078REM DEBUG                GOSUB 5600
5080     FOR J = M(C,0) TO M(C,1)
5081       REM COPY THE WORD W(J) IN X() AND APPEND IT
5082REM DEBUG            PRINT "COPY THE WORD " S$(W(J)) " IN X() AND APPEND IT"
5085       LET Y$ = S$(W(J))
5090       CHANGE Y$ TO X
5100       FOR K = 1 TO X(0)
5110         LET Z(Z0) = X(K)
5120         LET Z0 = Z0 + 1
5130       NEXT K
5140       LET Z(Z0) = 32
5150       LET Z0 = Z0 + 1
5160     NEXT J
5170     GOTO 5220
5200   LET Z(Z0) = Y(I)
5210   LET Z0 = Z0 + 1
5220 NEXT I
5230 LET Z(0) = Z0 - 1
5240 CHANGE Z TO Y$
5250 RETURN
