1005 REM
1011 REM    V A R I A B L E   D E F I N I T I O N S
1012 REM
1015 DIM A(32, 1)       ' ARRAY OF ALIASES
1016 LET A0 = 1         ' FIRST FREE ITEM IN A$()
1017 LET A9 = 32        ' SIZE OF A$()
1020 DIM D(1)           ' DEFAULT LIST: D(0) = START, D(1) = LENGTH
1022 LET D0 = 1         ' FIRST FREE ITEM IN A$()
1023 LET D9 = 16        ' SIZE OF D()
1025 DIM G(16,2)        ' ARRAY OF WORD GROUPS
1026 LET G0 = 1         ' FIRST FREE ITEM IN G$()
1027 LET G9 = 16        ' SIZE OF G$()
1035 DIM K(64,16)       ' KEYWORDS DATA
1036 LET K0 = 1         ' FIRST FREE ITEM IN K$() and K()
1037 LET K9 = 64        ' SIZE OF K()
1045 DIM R(64,2)        ' ARRAY OF RULES
1046 LET R0 = 1         ' FIRST FREE ITEM IN R()
1047 LET R9 = 64        ' SIZE OF  R()
1050 DIM S$(2048)       ' TABLE OF ALL STRINGS
1052 LET S0 = 1         ' FIRST FREE ITEM IN S$()
1053 LET S9 = 2048      ' SIZE OF S$()
1060 DIM T(128)         ' KEYSTACK
1062 LET T0 = 64        ' TOP OF STACK  
1063 LET T1 = 64        ' BOTTOM OF STACK
1065 LET T9 = 128       ' SIZE OF T()
1090 REM    VARIABLES USED BY SUBROUTINES
1091 DIM W(128), X(128), Y(128), Z(128)
1095 REM    NOTICE: VARIABLES STARTING BY X, Y, Z ARE USED BY SUBROUTINES
1100 REM
1101 REM    M A I N   P R O G R A M
1102 REM
1110 LET C0 = 0         ' COMMAND # OF THE SCRIPT UNDER EXECUTION
1120 RESTORE            ' DATA STATEMETS ARE THE SCRIPT: POINT TO THE FIRST ONE
1130 GOSUB 2000         ' PARSE SCRIPT
1140 GOSUB 3000         ' EXECUTE SCRIPT
1150 PRINT "GOODBYE"
1160 STOP
2000 REM
2001 REM    S C R I P T   P A R S I N G   S U B R O U T I N E
2002 REM
2005 LET C0 = C0 + 1
2010 READ X$
2015 IF X$ = "ALIAS" THEN 2100
2020 IF X$ = "DEFAULT" THEN 2200
2030 IF X$ = "GROUP" THEN 2300
2035 IF X$ = "KEYWORD" THEN 2400
2040 IF X$ = "PRINT" THEN 2700
2045 IF X$ = "RULE" THEN 2600
2065 IF X$ <> "END" THEN 2080
2070 RETURN
2080 PRINT "SCRIPT ERROR AT COMMAND #"; C0; ": ILLEGAL COMMAND "; X$
2090 STOP
2100 REM
2101 REM    EXECUTE "ALIAS", A$, B$
2102 REM
2105 IF A0 > A9 THEN 2150   ' ALIAS TABLE FULL!
2110   READ X$
2115   LET A(A0, 0) = S0    ' INDEX OF THE NEXT STRING TO BE INSERTED IN S$
2120   GOSUB 2900
2125   READ X$
2130   LET A(A0, 1) = S0    ' INDEX OF THE NEXT STRING TO BE INSERTED IN S$
2135   GOSUB 2900
2140   LET A0 = A0 + 1
2145   GOTO 2000
2150 PRINT "SCRIPT ERROR AT COMMAND #"; C0; ": NO MORE SPACE FOR ALIASES"
2160 STOP
2200 REM
2201 REM    EXECUTE "DEFAULT", A, B, ..., 0
2202 REM
2240 LET D(0) = S0
2245 GOSUB 2950           ' INSERT ALL GROUP ELEMENTS AT S$ FROM S0 ON
2250 LET D(1) = S0 - D(0)
2255 GOTO 2000
2300 REM
2301 REM    EXECUTE "GROUP", G$, W$, ..., ""
2302 REM
2310 IF G0 > G9 THEN 2370     ' GROUP TABLE FULL!
2315   READ X$
2320   IF ASC(X$) = 47 THEN 2335
2325     PRINT "SCRIPT ERROR AT COMMAND #"; C0; ": ILLEGAL GROUP NAME: SHOULD START WITH /"
2330     STOP
2335   LET G(G0,0) = S0
2335   GOSUB 2900           ' INSERT THE GROUP NAME AT S$(S0)
2340   LET G(G0,1) = S0
2345   GOSUB 2950           ' INSERT ALL GROUP ELEMENTS AT S$ FROM S0 ON
2350   LET G(G0,1) = S0 - G(G0,0)
2355   LET G0 = G0 + 1
2360   GOTO 2000
2370 PRINT "SCRIPT ERROR AT COMMAND #"; C0; ": NO MORE SPACE FOR GROUPS"
2375 STOP
2400 REM
2401 REM    EXECUTE "KEYWORD", K$, S$, RANK, R1, ..., 0
2402 REM
2410 IF K0 > K9 THEN 2505       ' KEYWORD TABLE FULL!
2415   READ X$                  ' READ THE KEYWORD'S NAME
2420   GOSUB 2800               ' INSERT THE NAME
2425   LET K(K0,0) = Y1
2430   READ X$                  ' READ THE KEYWORD ALIAS, IS ANY
2435   IF X$ <> "" THEN 2450
2440     LET K(K0,1) = 0        ' EMPTY STRING
2445     GOTO 2460
2450   GOSUB 2800               ' INSERT THE ALIAS
2455   LET K(K0,1) = Y1
2460   READ K(K0,2)             ' KEYWORD RANK
2465   FOR I = 4 TO 16
2470     READ K(K0,I)
2475     IF K(K0,I) = 0 THEN 2520
2480   NEXT I
2485   READ X1
2490   IF X1 = 0 THEN 2520
2495     PRINT "SCRIPT ERROR AT COMMAND #"; C0; ": TOO MANY RULES FOR A KEYWORD"
2500     STOP
2505 PRINT "SCRIPT ERROR AT COMMAND #"; C0; ": NO MORE SPACE FOR KEYWORDS"
2510 STOP
2520 LET K(K0,3) = I - 1
2525 LET K0 = K0 + 1
2530 GOTO 2000
2600 REM
2601 REM    EXECUTE "RULE", PATTERN$, TRANSFORM1$, ..., ""
2602 REM
2610 READ I                     ' READ RULE INDEX
2615 IF I < 1 THEN 2680
2616 IF I > R9 THEN 2680
2620 IF R(I,0) = 0 THEN 2640
2625   PRINT "SCRIPT ERROR AT COMMAND #"; C0;
2626   PRINT ": RULE WITH THE SAME INDEX ALREADY EXISTS"
2630   STOP
2640 READ X$            ' READ PATTERN
2645 GOSUB 2800         ' INSERT IN THE S$() TABLE WITH INDEX Y1
2650 LET R(I,0) = Y1    ' STORE IT AT R(I,0)
2655 LET R(I,1) = S0    ' START OF CONTIGUOUS STRING LIST (ITEMS COULD BE INSERTER TWICE)
2660 LET J = 0          ' LENGTH OF THE STRING LIST THAT FOLLOWS
2665 GOSUB 2950
2670 LET R(I,2) = S0 - R(I,1)
2675 GOTO 2000
2680 PRINT "SCRIPT ERROR AT COMMAND #"; C0; ": RULE INDEX OUT OF RANGE < 1 OR > ";R9
2685 STOP
2700 REM
2701 REM    EXECUTE "PRINT", X$
2702 REM
2705 READ X1$
2710 PRINT X1$
2715 GOTO 2000
2800 REM
2801 REM    I N S E R T   A   S T R I N G   X$   I N T O   S$()
2802 REM
2803 REM LOOKS FOR X$ INTO S$() AND RETURN ITS INDEX INTO Y1
2804 REM IF X$ IS NOT INSIDE S$(), THEN INSERT IT.
2805 REM
2810 FOR Y1 = 1 TO S0 - 1
2814 REM       PRINT "X$ " X$ "S$(Y1) " S$(Y1)
2815   IF X$ <> S$(Y1) THEN 2825
2820   RETURN
2825 NEXT Y1
2830 REM GOTO 2900
2900 REM
2901 REM    A P P E N D   A   S T R I N G   X$   T O   S$()
2902 REM
2910 IF S0 > S9 THEN 2930
2915 LET S$(S0) = X$
2920 LET S0 = S0 + 1
2925 RETURN
2930 PRINT "SCRIPT ERROR AT COMMAND #"; C0; ": STRING TABLE FULL"
2935 STOP
2950 REM
2951 REM    READ STRINGS UNTIL "" AND APPEND THEM TO S$()
2952 REM
2955 READ X$
2960 IF X$ <> "" THEN 2970
2965 RETURN
2970 GOSUB 2900
2975 GOTO 2955

3000 REM
3001 REM    S C R I P T   E X E C U T I O N   S U B R O U T I N E
3002 REM
3010 LET X$ = "."
3011 GOSUB 2800
3012 LET I1 = Y1            ' I1 = INDEX OF "." IN S$()
3015 LET X$ = ","
3011 GOSUB 2800
3012 LET I2 = Y1            ' I2 = INDEX OF "," IN S$()
3020 GOSUB 3500             ' GET TEXT AND SELECT KEYWORD
3025 IF T0 <> T1 THEN 3050  ' KEYWORDS FOUND
3029 REM HERE THE KEYSTACK IS EMPTY: PROMPT A DEFAULT ANSWER
3030 LET R = INT(RND*D(1))
3035 PRINT S$(D(0) + R)
3040 RETURN
3047 REM HERE FOR EACH KEYWORD, FROM THE TOPMOST, AND FOR EACH RULE OF SUCH
3048 REM    KEYWORD, A MATCH IS TRIED
3050 GOSUB 4000             ' TRY A MATCH FOR KEYWORD T(T0)

3499 RETURN

3500 REM
3501 REM    G E T   T E X T   A N D   S E L E C T   K E Y W O R D
3502 REM
3505 REM THE TEXT IS TOKENIZED IN WORDS AND STORED INTO W()
3506 REM KEYWORDS ARE ACCUMULATED INTO THE KEYSTACK ACCORDING TO THE ALGORITHM
3507 REM DESCRIBED IN WEIZENBAUM, FIG.2.
3510 LET T0 = 64        ' EMPTY KEYSTACK
3511 LET T1 = 64        ' EMPTY KEYSTACK
3515 LET P = 0          ' MAX PRECEDENCE OF A PARSED KEYWORD
3520 INPUT X$           ' USER PROMPT
3525 GOSUB 3700         ' PARSE X$ INTO A LIST OF WORDS GIVEN BY W()
3530 LET W0 = 0         ' INDEX OF NEXT PARSED WORD IN W()
3535   LET W0 = W0 + 1
3540   IF W0 <= W(0) THEN 3550
3545     RETURN
3550   IF W(W0) = I1 THEN 3650  ' IF W(W0) = "." THEN 3700
3551   IF W(W0) = I2 THEN 3650  ' IF W(W0) = "," THEN 3700
3554   REM CHECK IF W(W0) IS A KEYWORD
3553       PRINT "CHECK IF "S$(W(W0))" IS A KEYWORD"
3555   FOR K = 1 TO K0
3556       PRINT "CHECK IF "W(W0) "=" S$(W(W0))" IS "K(K,0) "=" S$(K(K,0))
3560     IF W(W0) = K(K,0) THEN 3570
3565   NEXT K
3567   GOTO 3535
3570   IF K(K,1) = 0 THEN 3600
3574     REM SUBSTITUTE EACH OCCURRENCE OF THE KEYWORD WITH THE ALIAS
3575     FOR J = 1 TO W(0)
3580       IF W(J) <> K(K,0) THEN 3590
3585         LET W(J) = K(K,1)
3590     NEXT J
3600   IF K(K,2) > P THEN 3630
3605     IF T0 >= 1 THEN 3615
3610       PRINT "KEYSTACK FULL!!!"
3611       STOP
3615     LET T(T0) = K
3616     LET T0 = T0 - 1
3620     LET P = K(K,2)
3625     GOTO 3535
3630   LET T1 = T1 + 1
3631   IF T1 <= T9 THEN 3640
3635       PRINT "KEYSTACK FULL!!!"
3636       STOP
3640     LET T(T1) = K
3645     GOTO 3535
3649   REM GET RID OF THE PREVIOUS/FOLLOWING KEYWORDS
3650   IF T0 <> T1 THEN 3665     ' IF KEYSTACK NOT EMPTY THEN 3665
3654     REM INSTEAD OF PHYSICALLY DELETE WORDS FROM W0 ON, WE TRUNCATE W()
3655     LET W(0) = W0 - 1
3660     RETURN
3664   REM DELETE ALL WORDS PRECEDING AND INCLUDING W0
3665   LET W(0) = W(0) - W0
3670   FOR I = 1 TO W(0)
3675     LET W(I) = W(I + W0)
3680   NEXT I
3690 GOTO 3535
3700 REM
3701 REM    P A R S E   W O R D S   F R O M   X$   I N T O   W()
3702 REM
3705 LET W(0) = 0       ' LENGTH OF THE WORD SEQUENCE
3710 CHANGE X$ TO X
3715 LET X1 = 1         ' NEXT CHARACTER IN X() TO PARSE
3720 IF X1 <= X(0) THEN 3730
3725   RETURN
3730 IF X(X1) <> 32 THEN 3750
3735   LET X1 = X1 + 1
3740 GOTO 3720
3750 IF X(X1) < 65 THEN 3790    ' NOT A LETTER
3751 IF X(X1) > 90 THEN 3790    ' NOT A LETTER
3755   REM PARSE THE WORD INTO Y()
3760   LET X2 = 1
3765     LET Y(X2) = X(X1)
3770     LET X1 = X1 + 1
3775     LET X2 = X2 + 1
3780     IF X1 > X(0) THEN 3790
3781     IF X(X1) < 65 THEN 3790
3782     IF X(X1) > 90 THEN 3790
3785   GOTO 3765
3790 LET Y(0) = X2 - 1
3794 REM NOW INSERT THE PARSED WORD INSIDE S$()
3795 CHANGE Y TO X$

QUI DEVI INSERIRE LA SOSTITUZIONE DEGLI ALIAS

3800 GOSUB 2800       ' INSERT X$ INTO S$() AND RETURN IN Y1 ITS INDEX
3805 LET W(0) = W(0) + 1
3810 LET W(W(0)) = Y1
3815 GOTO 3720
3819 REM A NON LETTER CHARACTER IS A SINGLETON STRING
3820 LET X$ = CHR$(X(X1))
3825 GOTO 3800




4000 REM
4001 REM    K E Y W O R D   R U L E S   M A T C H
4002 REM
4005 REM EXPECTS IN T(TO) THE INDEX IN K() OF A KEYWORD TO MATCH
4006 REM FIRST OF ALL, IF THE KEYWORD AS AN ALIAS, THEN SUBSTITUTE THE KEYWORD
4007 REM WITH THE ALIAS IN THE ALL SENTENCE.
4008 REM NEXT, FOR EACH RULE OF THE KEYWORD, TRY TO MATCH THE SENTENCE AND, IN

4100 PRINT "KSTACK"
4110 FOR I = T0 TO T1
4120 PRINT T(I), K(T(I),0), S$(K(T(I),0))
4130 NEXT I

9999 END
