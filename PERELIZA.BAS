1000 REM
1001 REM    P E R  E L I Z A
1002 REM
1003 REM    (C) 2026 BY PAOLO CARESSA
1004 REM    SEE DOCUMENTATION AT GITHUB.COM/PCARESSA/PERELIZA
1005 REM
1011 REM    V A R I A B L E   D E F I N I T I O N S
1012 REM
1015 DIM A$(32, 1)   ' Array of aliases
1016 LET A0 = 1      ' First free item in A$()
1017 LET A9 = 32     ' SIZE OF A$()
1020 DIM D(16)       ' Array of default rules
1021 LET D0 = 1      ' First free item in A$()
1022 LET D9 = 16     ' SIZE OF D()
1025 DIM G$(16,16)   ' Array of groups
1026 LET G0 = 1      ' First free item in G$()
1027 LET G9 = 16     ' SIZE OF G$()
1030 DIM K$(64,1)    ' Keyword names
1035 DIM K(64,16)    ' Keyword Rules
1036 LET K0 = 1      ' First free item in K$() and K()
1037 LET K9 = 64     ' SIZE OF K()
1040 DIM R$(256,16)  ' Array of rules
1045 DIM R(256)      ' Actual column used in each item of R$
1046 LET R0 = 1      ' First free item in R$()
1047 LET R9 = 256    ' SIZE OF R$() AND R()
1050 LET S0 = 0      ' COMMAND OF THE SCRIPT UNDER EXECUTION
1090 REM    VARIABLES USED BY SUBROUTINES
1091 DIM X(256), Y(256), Z(256)
1095 REM    NOTICE: VARIABLES STARTING BY X, Y, Z ARE USED BY SUBROUTINES
1100 REM
1101 REM    M A I N   P R O G R A M
1102 REM
1110 RESTORE
1120 GOSUB 2000      ' PARSE SCRIPT
1130 GOSUB 3000      ' EXECUTE SCRIPT
1140 PRINT "GOODBYE"
1150 STOP
2000 REM
2001 REM    S C R I P T   P A R S I N G   S U B R O U T I N E
2002 REM
2005 LET S0 = S0 + 1
2010 READ X$
2015 IF X$ = "ALIAS" THEN 2100
2020 IF X$ = "DEFAULT" THEN 2200
2030 IF X$ = "GROUP" THEN 2300
2035 IF X$ = "KEYWORD" THEN 2400
2040 IF X$ = "PRINT" THEN 2650
2045 IF X$ = "RULE" THEN 2500
2065 IF X$ <> "END" THEN 2080
2070 RETURN
2080 PRINT "SCRIPT ERROR AT COMMAND #"; S0; ": ILLEGAL COMMAND "; X$
2090 STOP
2100 REM
2101 REM    EXECUTE "ALIAS", A$, B$
2102 REM
2110 IF A0 > A9 THEN 2150     ' ALIAS TABLE FULL!
2120   READ A$(A0,0), A$(A0,1)
2130   LET A0 = A0 + 1
2140   GOTO 2000
2150 PRINT "SCRIPT ERROR AT COMMAND #"; S0; ": NO MORE SPACE FOR ALIASES"
2160 STOP
2200 REM
2201 REM    EXECUTE "DEFAULT", A, B, ..., 0
2202 REM
2210 IF D0 > D9 THEN 2270     ' DEFAULT TABLE FULL!
2220   READ I
2230   IF I = 0 THEN 2000
2240   LET D(D0) = I
2250   LET D0 = D0 + 1
2260   GOTO 2210
2270 PRINT "SCRIPT ERROR AT COMMAND #"; S0; ": NO MORE SPACE FOR DEFAULT RULES"
2280 STOP
2300 REM
2301 REM    EXECUTE "GROUP", G$, W$, ..., ""
2302 REM
2310 IF G0 > G9 THEN 2380     ' GROUP TABLE FULL!
2315   READ G$(G0,0)
2320   IF ASC(G$(G0,0)) = 47 THEN 2335
2325     PRINT "SCRIPT ERROR AT COMMAND #"; S0; ": ILLEGAL GROUP NAME: SHOULD START WITH /"
2330     STOP
2335   FOR I = 1 TO 16
2340     READ G$(G0,I)
2345     IF G$(G0,I) = "" THEN 2390
2350   NEXT I
2355   READ X1$
2360   IF X1$ = "" THEN 2390
2365     PRINT "SCRIPT ERROR AT COMMAND #"; S0; ": TOO MANY WORDS FOR A GROUP"
2370     STOP
2380 PRINT "SCRIPT ERROR AT COMMAND #"; S0; ": NO MORE SPACE FOR GROUPS"
2385 STOP
2390 LET G0 = G0 + 1
2395 GOTO 2000
2400 REM
2401 REM    EXECUTE "KEYWORD", K$, S$, RANK, R1, ..., 0
2402 REM
2410 IF K0 > K9 THEN 2460       ' KEYWORD TABLE FULL!
2412   READ K$(K0, 0), K$(K0,1) ' KEYWORD NAME AND SUBSTITUTE
2415   READ K(K0,0)             ' KEYWORD RANK
2420   FOR I = 1 TO 16
2425     READ K(K0,I)
2430     IF K(K0,I) = 0 THEN 2480
2435   NEXT I
2440   READ X1
2445   IF X1 = 0 THEN 2480
2450     PRINT "SCRIPT ERROR AT COMMAND #"; S0; ": TOO MANY RULES FOR A KEYWORD"
2455     STOP
2460 PRINT "SCRIPT ERROR AT COMMAND #"; S0; ": NO MORE SPACE FOR KEYWORDS"
2465 STOP
2480 LET K0 = K0 + 1
2490 GOTO 2000
2500 REM
2501 REM    EXECUTE "RULE", RANK, PATTERN$, TRANSFORM1$, ..., ""
2502 REM
2510 READ I
2515 IF I < 1 THEN 2600
2516 IF I > R9 THEN 2600
2520 IF R$(I,0) = "" THEN 2540
2525   PRINT "SCRIPT ERROR AT COMMAND #"; S0; ": RULE WITH THE SAME INDEX ALREADY EXISTS"
2530   STOP
2540 READ R$(I,0)    ' READ RULE PATTERN
2545 FOR J = 1 TO 16
2550   READ R$(I,J)
2555   IF R$(I,J) = "" THEN 2590
2560 NEXT J
2565 READ X1$
2570 IF X1$ = "" THEN 2585
2575   PRINT "SCRIPT ERROR AT COMMAND #"; S0; ": TOO MANY TRANSFORMS FOR A PATTERN"
2580   STOP
2585 LET I = 16
2590 LET R(I) = J
2595 GOTO 2000
2600 PRINT "SCRIPT ERROR AT COMMAND #"; S0; ": RULE INDEX OUT OF RANGE < 1 OR > ";R9
2605 STOP
2650 REM
2651 REM    EXECUTE "PRINT", X$
2652 REM
2655 READ X1$
2670 PRINT X1$
2675 GOTO 2000
3000 REM
3001 REM    S C R I P T   E X E C U T I O N   S U B R O U T I N E
3002 REM

9999 END
