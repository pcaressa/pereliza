4995 REM  EXPECT IN W() THE INPUT SENTENCE, POSSIBLY MODIFIED BY THE
4996 REM  PATTERN MATCHER, AND IN M() THE LIST OF MATCHED SYMBOLS
4997 REM  USE Z() TO STORE THE ANSWER, WHICH IS THEN CONVERTED IN Y$
4998 REM
5000 LET J = L(Y1 + 1)  ' INDEX OF NEXT ANSWER CORRESPONDING TO MATCHED PATTERN
5001REM DEBUG          PRINT "APPLY RULE"Y2"L[" Y1"] = ";
5002REM DEBUG          LET X5 = Y1
5003REM DEBUG          GOSUB 5800
