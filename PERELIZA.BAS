1011 REM    V A R I A B L E   D E F I N I T I O N S
1012 REM
1013 REM    NOTICE: MOST ARRAYS CONTAINS INDEXES TO ITEMS IN S$() OR L(), THE
1014 REM    TABLE OF STRINGS AND THE TABLE OF LISTS.
1015 DIM A(32, 1)   ' LIST OF ALIASES
1016 LET A0 = 1     ' FIRST FREE ITEM IN A$()
1017 LET A9 = 32    ' SIZE OF A$()
1020 LET D = 0      ' INDEX in L() OF DEFAULT LIST
1021 LET D0 = 1     ' NEXT ITEM IN THE DEFAULT LIST TO PRINT
1025 DIM G(16)      ' LIST OF GROUPS: G(I) IS THE INDEX IN L() OF THE LIST
1026 LET G0 = 1     ' FIRST FREE ITEM IN G()
1027 LET G9 = 16    ' SIZE OF G()
1035 DIM K(64,16)   ' LIST OF KEYWORDS
1036 LET K0 = 1     ' FIRST FREE ITEM IN  K()
1037 LET K9 = 64    ' SIZE OF K()
1040 DIM L(1024)    ' TABLE OF LIST ITEMS: ITEMS ARE INDEXES TO STRINGS IN S$()
1041 LET L0 = 1     ' FIRST FREE ITEM IN L()
1042 LET L9 = 1024  ' SIZE OF L()
1045 REM    LISTS ARE STORED AS CONSECUTIVE SEQUENCES OF INTEGERS IN L():
1046 REM    L(I) = SIZE OF THE LIST, L(I+1) = INDEX OF THE LIST
1047 REM    L(I+2), ..., L(I + 1 + L(I)) = INDEXES OF LIST ELEMENTS IN S$()
1050 DIM M(16,1)    ' LIST OF MATCHED ITEMS DURING INFERENCE
1051 LET M9 = 16    ' SIZE OF M()
1052 REM    ITEMS IN M(I) ARE PAIRS OF INDEXES, TO THE FIRST AND TO THE LAST
1053 REM    WORD IN W() (THE LIST OF PARSED WORDS FROM THE USER PROMPT) THAT
1054 REM    DELIMIT A SEQUENCE OF WORDS MATCHING THE I-TH ITEM OF A PATTERN
1055 DIM R(64)      ' ARRAY OF RULES
1056 LET R9 = 64    ' SIZE OF  R()
1057 REM    ITEMS IN R() INSERTED RANDOMLY, SO NO R0 IS NEEDED, JUST R9 = SIZE
1059 REM    R(I) = INDEX OF LIST (PATTERN, T1, ..., TN) IN L()
1060 DIM S$(2048)   ' TABLE OF ALL STRINGS
1062 LET S0 = 1     ' FIRST FREE ITEM IN S$()
1063 LET S9 = 2048  ' SIZE OF S$()
1065 REM    IN A SERIUOUS IMPLEMENTATION S$() WOULD BE HASHED, HERE WE DUMMILY
1066 REM    MAINTAIN IT AS A STACK...
1070 DIM T(64)      ' KEYWORD STACK
1072 LET T0 = 32    ' TOP OF STACK: PUSHED ITEMS GOES BELOW IT 
1073 LET T1 = 32    ' BOTTOM OF STACK: QUEUED ITEMS GOES ABOVE IT
1074 LET T9 = 64    ' SIZE OF T()
1075 REM    ON THE KEYWORD STACK T() ITEMS CAN BE PUSHED EITHER TO THE TOP
1076 REM    OR TO THE BOTTOM, SO THERE ARE TWO STACK POINTER, T0 DECREASING AND
1077 REM    T1 INCREASING, WHEN THEY ARE EQUAL THE STACK IS EMPTY.
1080 DIM W(128)     ' WORD (=INDEXES TO S$()) LIST PARSED FROM USER INPUT
1094 REM VARIABLES STARTING BY X, Y, Z ARE USED BY SUBROUTINES
1095 DIM X(128), Y(128), Z(128)
1100 REM
1101 REM    M A I N   P R O G R A M
1102 REM
1110 LET C0 = 0     ' COMMAND # OF THE SCRIPT UNDER EXECUTION
1120 RESTORE        ' DATA STATEMENTS ARE THE SCRIPT: POINT TO THE FIRST ONE
1130 GOSUB 2000     ' PARSE SCRIPT
1131 REM           FOR K2 = 1 TO K0
1132 REM               GOSUB 5500
1133 REM           NEXT K2
1135 REM           GOSUB 5300
1140 GOSUB 3000     ' EXECUTE SCRIPT
1150 PRINT "GOODBYE"
1160 STOP
2000 REM
2001 REM    S C R I P T   P A R S I N G   S U B R O U T I N E
2002 REM
2005 LET C0 = C0 + 1
2010 READ X$
2015 IF X$ = "ALIAS" THEN 2100
2020 IF X$ = "DEFAULT" THEN 2200
2030 IF X$ = "GROUP" THEN 2300
2035 IF X$ = "KEYWORD" THEN 2400
2040 IF X$ = "PRINT" THEN 2700
2045 IF X$ = "RULE" THEN 2600
2065 IF X$ <> "END" THEN 2080
2070 RETURN
2080 PRINT "SCRIPT @ CMD COMMAND #"; C0; ": ILLEGAL COMMAND "; X$
2090 STOP
2100 REM
2101 REM    EXECUTE "ALIAS", A$, B$
2102 REM
2105 IF A0 > A9 THEN 2150   ' ALIAS TABLE FULL!
2110   READ X$
2115   LET A(A0, 0) = S0    ' INDEX OF WORD TO BE INSERTED
2120   GOSUB 2800           ' INSERT X$ IN S$() AND RETURN INDEX IN Y1
2125   READ X$
2130   LET A(A0, 1) = S0    ' INDEX OF WORD TO BE INSERTED
2135   GOSUB 2800           ' INSERT X$ IN S$() AND RETURN INDEX IN Y1
2140   LET A0 = A0 + 1
2145   GOTO 2000
2150 PRINT "SCRIPT @ CMD COMMAND #"; C0; ": NO MORE SPACE FOR ALIASES"
2160 STOP
2200 REM
2201 REM    EXECUTE "DEFAULT", A, B, ..., 0
2202 REM
2210 IF D = 0 THEN 2225
2215   PRINT "SCRIPT @ CMD COMMAND #"; C0; ": DEFAULT ALREADY SETTLED"
2220   STOP
2225 GOSUB 2900           ' READ A LIST AND RETURN IN Y0 ITS INDEX
2250 LET D = Y0
2255 GOTO 2000
2300 REM
2301 REM    EXECUTE "GROUP", G$, W$, ..., ""
2302 REM
2310 IF G0 > G9 THEN 2370   ' GROUP TABLE FULL!
2315   GOSUB 2900           ' READ A LIST AND RETURN IN Y0 ITS INDEX
2320   LET G(G0) = Y0
2330   LET G0 = G0 + 1
2335   IF ASC(S$(L(Y0+2))) = 39 THEN 2000
2350   PRINT "SCRIPT @ CMD COMMAND #"; C0; ": ILLEGAL GROUP NAME: SHOULD START WITH '"
2360   STOP
2370 PRINT "SCRIPT @ CMD COMMAND #"; C0; ": NO MORE SPACE FOR GROUPS"
2375 STOP
2400 REM
2401 REM    EXECUTE "KEYWORD", K$, S$, RANK, R1, ..., 0
2402 REM
2410 IF K0 > K9 THEN 2505       ' KEYWORD TABLE FULL!
2415   READ X$                  ' READ THE KEYWORD'S NAME
2420   LET K(K0,0) = S0
2425   GOSUB 2800               ' INSERT THE NAME
2430   READ X$                  ' READ THE KEYWORD ALIAS, IS ANY
2435   IF X$ <> "" THEN 2450
2440     LET K(K0,1) = 0        ' EMPTY STRING
2445     GOTO 2460
2450   LET K(K0,1) = S0
2455   GOSUB 2800               ' INSERT THE ALIAS
2460   READ K(K0,2)             ' KEYWORD RANK
2465   FOR I = 4 TO 16          ' READ RULE NUMBERS UNTIL A 0 IS FOUND
2470     READ K(K0,I)
2475     IF K(K0,I) = 0 THEN 2520
2480   NEXT I
2485   READ X1
2490   IF X1 = 0 THEN 2520
2495     PRINT "SCRIPT @ CMD COMMAND #"; C0; ": TOO MANY RULES FOR A KEYWORD"
2500     STOP
2505 PRINT "SCRIPT @ CMD COMMAND #"; C0; ": NO MORE SPACE FOR KEYWORDS"
2510 STOP
2520 LET K(K0,3) = I - 4
2525 LET K0 = K0 + 1
2530 GOTO 2000
2596 REM
2597 REM    EXECUTE "RULE", PATTERN$, TRANSFORM1$, ..., ""
2598 REM
2600 READ I             ' READ RULE INDEX
2605 IF I < 1 THEN 2680
2610 IF I > R9 THEN 2680
2615 IF R(I) = 0 THEN 2640
2625   PRINT "SCRIPT @ CMD COMMAND #"; C0; ": RULE WITH INDEX "; I; " ALREADY EXISTS"
2630   STOP
2640 GOSUB 2900         ' READ A LIST AND RETURN IN Y0 ITS INDEX
2650 LET R(I) = Y0
2660 LET R2 = I
2670REM DEBUG  GOSUB 5750
2675 GOTO 2000
2680 PRINT "SCRIPT @ CMD COMMAND #"; C0; ": RULE INDEX "; I; " OUT OF RANGE < 1 OR > ";R9
2685 STOP
2700 REM
2701 REM    EXECUTE "PRINT", X$
2702 REM
2705 READ X$
2710 PRINT X$
2715 GOTO 2000
2791 REM
2792 REM    A P P E N D   A   S T R I N G   X$   T O   S$()
2793 REM
2794 REM    RETURN IN Y1 THE INDEX OF THE STRING IN S$()
2795 REM
2800 IF S0 <= S9 THEN 2815
2805   PRINT "SCRIPT @ CMD COMMAND #"; C0; ": STRING TABLE FULL"
2810   STOP
2815 LET S$(S0) = X$
2820 LET S0 = S0 + 1
2825 RETURN
2892 REM
2893 REM    R E A D   &   I N S E R T   A   L I S T   O F   S T R I N G S
2894 REM
2895 REM    RETURN IN Y0 THE INDEX OF THE LIST IN L(): RECALL THAT A LIST IS
2896 REM    AS (LENGTH, INDEX, S1, ..., SN).
2897 REM
2900 LET Y0 = L0        ' INDEX OF LENGTH OF THE STRING
2905 LET L0 = L0 + 1
2910 LET L(L0) = 1      ' SET LIST INDEX TO 1
2915 LET L0 = L0 + 1    ' INDEX OF FIRST ITEM IN THE LIST
2920   IF L0 > L9 THEN 2960
2925     READ X$
2930     IF X$ <> "" THEN 2945
2931       REM WARNING: NO CHECK ON EMPTY LISTS!!!
2935       LET L(Y0) = L0 - Y0 - 2  ' LENGHT OF LIST
2940       RETURN
2945     LET L(L0) = S0
2950     GOSUB 2800
2955     GOTO 2915
2960 PRINT "SCRIPT @ CMD COMMAND #"; C0; ": LIST TABLE FULL"
2970 STOP
3000 REM
3001 REM    S C R I P T   E X E C U T I O N   S U B R O U T I N E
3002 REM
3004 REM THE FOLLOWING VARIABLES SAVE THE VALUE OF THE CURRENT BOUNDARY OF S$()
3005 REM AND L() SO TO DISCARD STRINGS AND LISTS INSERTED DURING EXECUTION.
3010 LET L8 = L0
3020 LET S8 = S0
3025   INPUT X$                 ' USER PROMPT
3030   IF X$ <> "" THEN 3040    ' JUMP IF NOT AN EMPTY PROMPT
3035     RETURN
3040   GOSUB 3500               ' GET PARSED PROMPT INTO W() AND KEYSTACK T()
3041REM DEBUG GOSUB 5900
3045   IF T0 = T1 THEN 3100     ' JUMP IF NO KEYWORD FOUND
3047     CHANGE W TO Z$         ' SAVES W() WHICH CAN BE ALTERED BY SUBR 4000
3050     GOSUB 4000             ' USE KEYWORDS IN THE STACK TO SELECT RULES TO APPLY
3060     IF Y1 = 0 THEN 3100    ' JUMP IF NO MATCH COULD BE FOUND
3061       REM Y2 = RULE NUMBER, Y1 = R(Y2), K2 = CORRESPONDING KEYWORD
3065       GOSUB 4900           ' APPLY ALIASES TO W() AND ALSO RULE SUBSTITUTION
3070       LET X1 = Y2
3075       GOSUB 5000           ' APPLY RULE X1 AND RETURN IN Y$ THE ANSWER
3080       PRINT Y$
3090       GOTO 3170
3100     IF D = 0 THEN 3170     ' JUMP IF NO DEFAULT SETTLED, SO NO ANSWER
3101       REM L(D) = LENGHT, L(D+1) = INDEX, L(D+2), ... = LIST ELEMENTS
3110       LET I = L(D+1)       ' ITEM OF THE LIST TO CHOOSE
3120       PRINT S$(L(D + 1 + I)) ' NEXT DEFAULT ANSWER FROM LIST L(D)
3130       LET I = I + 1        ' INCREASE DEFAULT ANSWER INDEX
3140       IF I <= L(D) THEN 3160 ' JUMP IF NEXT INDEX IS VALID
3150         LET I = 1          ' RESET THE DEFAULT ANSWER INDEX
3160       LET L(D+1) = I       ' UPDATE THE INDEX IN THE LIST
3170   LET S0 = S8              ' DROP ALL WORDS INSERTED DURING EXECUTION
3180   LET L0 = L8              ' DROP ALL LIST ITEMS INSERTED DURING EXECUTION
3190 GOTO 3025
3500 REM
3501 REM    G E T   T E X T   A N D   S E L E C T   K E Y W O R D
3502 REM
3505 REM THE TEXT X$ IS TOKENIZED IN WORDS AND STORED INTO W()
3506 REM KEYWORDS ARE ACCUMULATED INTO THE KEYSTACK ACCORDING TO THE ALGORITHM
3507 REM DESCRIBED IN WEIZENBAUM, FIG.2.
3508 REM
3510 LET T0 = T9/2      ' EMPTY KEYSTACK BY LETTING T0 = T1
3511 LET T1 = T9/2      ' EMPTY KEYSTACK BY LETTING T0 = T1
3515 LET P = 0          ' MAX PRECEDENCE OF A PARSED KEYWORD
3520 GOSUB 3800         ' PARSE X$ INTO A LIST OF WORDS GIVEN BY Y()
3525    REM GOSUB 3900         ' SUBSTITUTE ALIASES
3529 REM COPY THE RESULT INTO LIST W()
3530 FOR I = 0 TO Y(0)
3535   LET W(I) = Y(I)
3540 NEXT I
3545 LET W0 = 0         ' INDEX OF NEXT PARSED WORD IN W()
3550   LET W0 = W0 + 1
3555     IF W0 <= W(0) THEN 3565
3560       RETURN
3565     IF S$(W(W0)) = "." THEN 3690
3570     IF S$(W(W0)) = "," THEN 3690
3575     REM CHECK IF W(W0) IS A KEYWORD
3580     FOR K = 1 TO K0
3581REM DEBUG  PRINT "CHECK IF "W(W0) " = " S$(W(W0)) " IS "K(K,0) " = " S$(K(K,0))
3585       IF S$(W(W0)) = S$(K(K,0)) THEN 3600
3590     NEXT K
3595     GOTO 3550    ' NOT A KEYWORD, TRY NEXT WORD.
3600   IF K(K,1) = 0 THEN 3625
3604   REM  REM SUBSTITUTE EACH OCCURRENCE OF THE KEYWORD WITH THE ALIAS
3605   REM  FOR J = 1 TO W(0)
3610   REM    IF W(J) <> K(K,0) THEN 3620
3615   REM      LET W(J) = K(K,1)
3620   REM  NEXT J
3620   REM  LET W(W0) = K(K,1)     ' SUBSTITUTE THE KEYWORD WITH ITS ALIAS
3625   IF K(K,2) > P THEN 3660
3630     IF T0 >= 1 THEN 3640
3635       PRINT "KEYSTACK FULL!!!"
3636       STOP
3640     LET T(T0) = K
3645     LET T0 = T0 - 1
3650     LET P = K(K,2)
3655     GOTO 3550
3660   LET T1 = T1 + 1
3665   IF T1 <= T9 THEN 3680
3670       PRINT "KEYSTACK FULL!!!"
3675       STOP
3680     LET T(T1) = K
3685     GOTO 3550
3689   REM GET RID OF THE PREVIOUS/FOLLOWING KEYWORDS
3690   IF T0 <> T1 THEN 3710     ' JUMP IF KEYSTACK NOT EMPTY
3695     LET W(0) = W0 - 1 ' DON'T DELETE WORDS, JUST TRUNCATE W() LENGTH
3700     RETURN
3705   REM DELETE ALL WORDS PRECEDING AND INCLUDING W0
3710   LET W(0) = W(0) - W0
3715   FOR I = 1 TO W(0)
3720     LET W(I) = W(I + W0)
3725   NEXT I
3730 GOTO 3545  ' RESET W0 AND REPEAT LOOP
3796 REM
3797 REM    P A R S E   W O R D S   F R O M   X$   I N T O   Y()
3798 REM
3800 LET Y(0) = 0               ' LENGTH OF THE WORD SEQUENCE
3802 LET Y0 = 0                 ' LENGTH OF Y()
3805 CHANGE X$ TO X             ' X() CONTAINS CHARACTERS OF STRING TO PARSE
3810 LET X8 = 1                 ' NEXT CHARACTER IN X() TO PARSE
3815   IF X8 <= X(0) THEN 3820
3816     LET Y(0) = Y0
3817     RETURN
3820   LET C = X(X8)
3825   IF C <> 32 THEN 3840
3830     LET X8 = X8 + 1        ' SKIP SPACE
3835   GOTO 3815
3839   REM THE PARSED WORD IS STORED IN Z()
3840   LET Z1 = 1               ' LENGTH OF Z()
3842   LET Z(Z1) = C
3844   LET Z1 = Z1 + 1
3845   LET X8 = X8 + 1
3850   IF C = 39 THEN 3855      ' APOSTROPHE IS CONSIDERED A LETTER
3851   IF C < 65 THEN 3885      ' NOT A LETTER
3852   IF C > 90 THEN 3885      ' NOT A LETTER
3854     REM PARSE THE REST OF THE WORD INTO Z()
3855     IF X8 > X(0) THEN 3885 ' END OF INPUT TEXT
3860       LET C = X(X8)
3865       IF C = 39 THEN 3870  ' APOSTROPHE IS CONSIDERED A LETTER
3866       IF C < 65 THEN 3885  ' NOT A LETTER
3867       IF C > 90 THEN 3885  ' NOT A LETTER
3870       LET Z(Z1) = C
3875       LET X8 = X8 + 1
3876       LET Z1 = Z1 + 1
3880       GOTO 3855
3884   REM HERE X8 POINTS THE NEXT CHARACTER IN X() AND Z1 = LEN Z() + 1
3885   LET Z(0) = Z1 - 1
3887   LET Y0 = Y0 + 1
3889   LET Y(Y0) = S0
3890   CHANGE Z TO X$
3892   GOSUB 2800       ' INSERT X$ INTO S$() AT INDEX S0
3895 GOTO 3815
3896 REM
3897 REM    S U B S T I T U T E   A L I A S E S   I N   Y()
3898 REM
3900 FOR I = 1 TO Y(0)
3910   FOR J = 1 TO A0
3920     IF S$(A(J,0)) <> S$(Y(I)) THEN 3940
3930       LET Y(I) = A(J,1)   ' CHANGES THE WORD
3940   NEXT J
3950 NEXT I
3960 RETURN
3991 REM
3992 REM    K E Y W O R D   R U L E S   M A T C H
3993 REM
3994 REM EXPECTS IN T(TO) THE INDEX, IN K(), OF A KEYWORD TO MATCH
3995 REM FIRST OF ALL, IF THE KEYWORD AS AN ALIAS, THEN SUBSTITUTE THE KEYWORD
3996 REM WITH THE ALIAS IN THE ALL SENTENCE.
3997 REM NEXT, FOR EACH RULE OF THE KEYWORD, TRY TO MATCH THE SENTENCE AND, IN
3998 REM CASE OF MATCH RETURN  Y1 = INDEX OF THE RULE, Y2 = RULE #, ELSE Y1 = 0
3999 REM K2 CONTAINS THE INDEX OF THE KEYWORD IN CASE Y1 <> 0
4000 LET K2 = T(T0 + 1)   ' INDEX OF KEYWORD UNDER CONSIDERATION
4010   LET X1 = K(K2, 1)  ' INDEX IN S$() OF THE ALIAS OF THE KEYWORD
4015REM DEBUG  PRINT "CONSIDER KEYWORD "; S$(K(K2,0)); "=>"; S$(X1)
4016REM DEBUG  GOSUB 5500
4017REM DEBUG  PRINT
4020   IF X1 = 0 THEN 4070
4024     REM SUBSTITUTE THE ALIAS IN THE ALL WORD W()
4024REM DEBUG  PRINT "SUBSTITUTE" S$(K(K2,0))" > " S$(X1) " IN THE ALL WORD W()"
4026     LET X$ = S$(K(K2,0))
4030     FOR I = 1 TO W(0)
4040       IF S$(W(I)) <> X$ THEN 4060
4050         LET W(I) = X1
4060     NEXT I
4068   REM NOW SCANS ALL RULES TO FIND A MATCH
4070   FOR I4 = 4 TO 3 + K(K2,3)
4080     LET X1 = K(K2,I4)      ' INDEX OF THE RULE TO CHECK IN R()
4084REM DEBUG  PRINT "X1 = " X1
4090     GOSUB 4200             ' MATCH RULE PATTERN X1 AGAINST W(): RESULT IN Y1, Y2
4100     IF Y1 = 0 THEN 4140    ' JUMP IF NO MATCH
4130       RETURN
4140   NEXT I4
4150   LET T0 = T0 + 1
4160 IF T0 <= T1 THEN 4000
4170 LET Y1 = 0   ' NO MATCH FOUND!
4180 RETURN
4191 REM
4192 REM    M A T C H   W()   A G A I N S T   R U L E   R(X1)
4193 REM
4194 REM    IF SUCCEED, THEN RETURN IN Y1 THE INDEX OF THE LIST CORRESPONDING
4195 REM    TO THE RULE TO APPLY ELSE, Y2 = RULE #; ELSE Y1 = Y2 = 0
4196 REM
4200 LET Y2 = X1                ' RULE NUMBER, NEEDED IN OUTPUT
4201 LET R1 = R(Y2)           ' LIST REPRESENTING THE RULE UNDER MATCHING
4202 LET X$ = S$(L(R1+2))       ' PATTERN TO MATCH
4204 REM IF X$ <> "0" THEN 4210 ' JUMP IF IT IS NOT JUST "0"
4206 REM   LET M(1,0) = 1
4207 REM  LET M(1,1) = W(0)
4208 REM  LET M0 = 1
4209 REM  GOTO 4410
4210 GOSUB 3800                 ' WORD LIST OF THE PATTERN X$ IN Y()
4211 LET X$ = S$(L(R1+2))       ' PATTERN TO MATCH
4212REM DEBUG        PRINT "RULE " X1 " MATCH '";
4213REM DEBUG        FOR U = 1 TO Y(0)
4215REM DEBUG          PRINT S$(Y(U)) " ";
4217REM DEBUG        NEXT U
4218REM DEBUG        PRINT "' ("X$")' AGAINST "; CHR$(34);
4223REM DEBUG        FOR U = 1 TO W(0)
4225REM DEBUG          PRINT S$(W(U)) " ";
4227REM DEBUG        NEXT U
4229REM DEBUG        PRINT CHR$(34)
4236 REM
4238 REM PATTERNS ARE LIST OF SYMBOLS "0"/GROUP NAME/WORD POSSIBLY SEPARATED
4239 REM BY NON CONSECUTIVE "0"S. EACH MATCHED ITEM IS A SUBSTRING OF W()
4240 REM INDEXED BY M(I,0) AND M(I,1). AFTER A "0", THE NEXT SYMBOL IS
4241 REM CONSIDERED, AND THE ALGORITHM TRIES TO FIND THE NEXT MATCH TO IT IN W()
4242 REM ASSIGNING ALL SKIPPED WORDS TO THE "0". 
4245 REM
4250 LET M0 = 1                         ' INDEX IN M()
4255 LET W0 = 1                         ' INDEX IN W()
4260 FOR Y0 = 1 TO Y(0)                 ' INDEX OF NEXT SYMBOL IN PATTERN
4261   IF W0 > W(0) THEN 4430           ' NO MORE TEXT TO MATCH ("0" CANNOT BE EMPTY)
4265   LET X$ = S$(Y(Y0))               ' CURRENT SYMBOL
4270   LET X1 = W(W0)                   ' NEXT WORD TO MATCH
4275REM DEBUG   PRINT "4280 MATCH " X$ " VS " S$(X1)
4280   IF X$ = "0" THEN 4340            ' JUMP IF METASYMBOL "0"
4285     IF ASC(X$) = 39 THEN 4300      ' JUMP IF GROUP NAME
4290       IF X$ <> S$(X1) THEN 4430    ' JUMP IF SINGLE WORD DOES NOT MATCH
4295         LET M(M0,0) = W0
4296         LET M(M0,1) = W0
4298         GOTO 4360                  ' CONTINUE MATCHING
4299     REM CHECK IF W(W0) IS A WORD IN GROUP X$
4300     GOSUB 4450   ' LOOKS FOR X1 = W(W0) IN GROUP X$
4320     IF Y1 = 0 THEN 4430            ' JUMP IF W(W0) IS NOT N ELEMENT OF GROUP
4325       LET M(M0,0) = W0
4326       LET M(M0,1) = W0
4330       GOTO 4360                  ' CONTINUE MATCHING
4340   GOSUB 4500                       ' TRY TO MATCH "0"
4360   LET W0 = W0 + 1
4380   LET M0 = M0 + 1
4390   IF M0 <= M9 THEN 4400
4395     PRINT "TOO MANY ITEMS IN PATTERN RULE "; R1
4396     STOP
4400 NEXT Y0
4409 REM HERE THE MATCH SUCCEEDED
4410 LET Y1 = R1
4415REM DEBUG        PRINT "MATCH SUCCEEDED!"
4420 RETURN
4429 REM HERE THE MATCH FAILED
4430 LET Y1 = 0
4435REM DEBUG        PRINT "MATCH FAILED!"
4440 RETURN
4446 REM
4447 REM    L O O K   F O R   S$(X1)   I N   G R O U P   X$
4448 REM
4449 REM    RETURN Y1 <> 0 IF FOUND, ELSE Y1 = INDEX IN L() OF THE GROUP
4450 FOR I5 = 1 TO G0 - 1
4455   IF S$(L(G(I5)+2)) <> X$ THEN 4485
4456     REM SCAN GROUP ITEMS TO FIND A MATCH WITH S$(X1): A GROUP LIST IS
4457     REM STORED IN L() AS (LEN = L(G(I)), GROUPNAME, ITEM1, ...)
4460     FOR J5 = G(I5) + 3 TO G(I5) + 1 + L(G(I5))
4461REM DEBUG            PRINT "4460 MATCH " S$(X1) " WITH " X$"."S$(L(J5))
4465       IF S$(L(J5)) <> S$(X1) THEN 4475
4470         LET Y1 = G(I5)
4471         RETURN
4475     NEXT J5
4480     LET Y1 = 0
4481     RETURN
4485 NEXT I5
4490 PRINT "UNDEFINED GROUP "; X$
4491 STOP
4493 REM
4494 REM    M A T C H   W I L D C A R D
4495 REM
4496 REM  HERE THE SYMBOL Y(Y0) IS THE WILD CHARACTER "0". LOOK AT THE NEXT
4497 REM  SYMBOL: IF THERE ARE NO MORE SYMBOLS, THEN THE REST OF W() IS
4498 REM  MATCHED BY THE "0". EXPECTS W0 to index the current word in W()
4499 REM
4500 IF Y0 <> Y(0) THEN 4545      ' IF MORE SYMBOLS FOLLOW
4509   REM ALL REMAINING WORDS IN W() MATCH THE "0": WE HAVE A MATCH!!!
4510   LET M(M0,0) = W0         ' FROM NEXT WORD NOT YET SCAN IN W()
4520   LET M(M0,1) = W(0)       ' TO LAST WORD OF W()
4525   LET W0 = W(0)            ' UPDATE WORD INDEX IN W()
4530   LET Y1 = R1              ' RESULT = OK!
4540   RETURN
4545 LET Y0 = Y0 + 1            ' INDEX OF NEXT SYMBOL         
4550 LET X$ = S$(Y(Y0))         ' NEXT SYMBOL IN X$
4555 IF X$ <> "0" THEN 4580     ' JUMP IF IS NOT "0"
4560   PRINT "ILLEGAL PATTERN RULE "; R1; " TWO CONSECUTIVE '0'"
4570   STOP
4580 LET W1 = W0        ' SINCE W0 COULD BE INCREASED HEREAFTER, WE SAVE IT
4585 REM LET W0 = W0 + 1    ' "0" DOES NOT MATCH THE EMPTY STRING.
4590 IF ASC(X$) <> 39 THEN 4740  ' JUMP IF IS NOT A GROUP
4591   REM HERE, X1 AND X$ HAVE THE CORRECT VALUE EXPECTED BY 4450
4592   REM NOW LOOKS FROM W(W0) ON TO FIND A WORD IN GROUP X$
4595   LET X1 = W(W0)
4600   GOSUB 4450   ' LOOKS FOR X1 = W(W0) IN GROUP X$
4610   IF Y1 <> 0 THEN 4670 ' JUMP IF FOUND MATCH WITH A GROUP ELEMENT
4620     LET W0 = W0 + 1
4630     IF W0 > W(0) THEN 4660
4650       GOTO 4595
4659     REM HERE, WE COULD NOT FIND A MATCH
4660     RETURN   ' Y1 IS ALREADY 0, HERE
4669   REM HERE, WE GOT A MATCH: STORE IN M() BOTH "0" AND THE GROUP SYMBOL
4670   LET M(M0,0) = W1
4680   LET M(M0,1) = W0 - 1
4690   LET M0 = M0 + 1
4700   IF M0 > M9 THEN 4395    ' ERROR: OUT OF M()
4710   LET M(M0,0) = W0
4720   LET M(M0,1) = W0
4725   LET Y1 = R1
4730   RETURN
4739 REM HERE, A MATCH WITH A SINGLE WORD SHOULD BE FOUND
4740 IF S$(W(W0)) = X$ THEN 4670    ' FOUND A MATCH
4745REM DEBUG  PRINT "NO MATCH BETWEEN " X$ " AND " S$(W(W0)) "W0 = " W0 " W(0) = " W(0)
4750 LET W0 = W0 + 1
4755 IF W0 <= W(0) THEN 4740
4760 LET Y1 = 1     ' GOT MATCH
4790 RETURN
